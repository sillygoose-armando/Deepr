CREATE TABLE Profile (
id INTEGER PRIMARY KEY NOT NULL,
name TEXT NOT NULL UNIQUE,
createdAt TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
themeMode TEXT NOT NULL DEFAULT 'system',
colorTheme TEXT NOT NULL DEFAULT 'dynamic',
priority INTEGER NOT NULL DEFAULT 0
);

CREATE INDEX IF NOT EXISTS idx_profile_priority_createdAt
ON Profile(priority, createdAt);

CREATE TABLE Deepr (
id INTEGER PRIMARY KEY NOT NULL,
link TEXT NOT NULL,
name TEXT NOT NULL DEFAULT '',
createdAt TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
openedCount INTEGER NOT NULL DEFAULT 0,
isFavourite INTEGER NOT NULL DEFAULT 0,
notes TEXT NOT NULL DEFAULT '',
thumbnail TEXT NOT NULL DEFAULT '',
profileId INTEGER NOT NULL DEFAULT 1,
syncId TEXT,
FOREIGN KEY (profileId) REFERENCES Profile(id) ON DELETE CASCADE
);

CREATE TABLE Tags (
id INTEGER PRIMARY KEY NOT NULL,
name TEXT NOT NULL UNIQUE
);

CREATE TABLE LinkTags (
linkId INTEGER NOT NULL,
tagId INTEGER NOT NULL,
PRIMARY KEY (linkId, tagId),
FOREIGN KEY (linkId) REFERENCES Deepr(id) ON DELETE CASCADE,
FOREIGN KEY (tagId) REFERENCES Tags(id) ON DELETE CASCADE
);

CREATE TABLE DeeprOpenLog (
id INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
deeplinkId INTEGER NOT NULL,
openedAt TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
FOREIGN KEY (deeplinkId) REFERENCES Deepr(id) ON DELETE CASCADE
);

-- P2P sync (see docs/p2p-sync/PLAN.md). SQL must stay compatible with SQLite 3.9 (Android API 24):
-- no UPSERT, no window functions. Meta rows are never updated in place: a change INSERTs a new row
-- (fresh AUTOINCREMENT seq) and then deletes the superseded rows of the same key.
CREATE UNIQUE INDEX IF NOT EXISTS idx_deepr_syncId ON Deepr(syncId);

CREATE TABLE SyncDevice (
id INTEGER PRIMARY KEY NOT NULL CHECK (id = 1),
deviceId TEXT NOT NULL,
deviceName TEXT NOT NULL DEFAULT '',
hlc INTEGER NOT NULL DEFAULT 0,
applying INTEGER NOT NULL DEFAULT 0,
maxPeers INTEGER NOT NULL DEFAULT 5
);

INSERT INTO SyncDevice (id, deviceId) VALUES (1, lower(hex(randomblob(16))));

CREATE TABLE SyncShare (
shareId TEXT PRIMARY KEY NOT NULL,
profileId INTEGER NOT NULL UNIQUE,
createdAt INTEGER NOT NULL,
FOREIGN KEY (profileId) REFERENCES Profile(id) ON DELETE CASCADE
);

CREATE TABLE SyncMeta (
seq INTEGER PRIMARY KEY AUTOINCREMENT NOT NULL,
shareId TEXT NOT NULL,
syncId TEXT NOT NULL,
tagName TEXT NOT NULL DEFAULT '',
hlc INTEGER NOT NULL,
origin TEXT NOT NULL,
deleted INTEGER NOT NULL DEFAULT 0,
FOREIGN KEY (shareId) REFERENCES SyncShare(shareId) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS idx_syncmeta_key ON SyncMeta(shareId, syncId, tagName);
CREATE INDEX IF NOT EXISTS idx_syncmeta_syncId ON SyncMeta(syncId);
CREATE INDEX IF NOT EXISTS idx_syncmeta_tagName ON SyncMeta(tagName);

CREATE TABLE SyncPeer (
peerId TEXT PRIMARY KEY NOT NULL,
name TEXT NOT NULL,
keyEnc BLOB NOT NULL,
lastHost TEXT NOT NULL DEFAULT '',
lastPort INTEGER NOT NULL DEFAULT 0,
addedAt INTEGER NOT NULL,
lastSyncAt INTEGER NOT NULL DEFAULT 0,
lastError TEXT NOT NULL DEFAULT '',
needsRepair INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE SyncPeerShare (
peerId TEXT NOT NULL,
shareId TEXT NOT NULL,
pushedUpTo INTEGER NOT NULL DEFAULT 0,
pulledUpTo INTEGER NOT NULL DEFAULT 0,
PRIMARY KEY (peerId, shareId),
FOREIGN KEY (peerId) REFERENCES SyncPeer(peerId) ON DELETE CASCADE,
FOREIGN KEY (shareId) REFERENCES SyncShare(shareId) ON DELETE CASCADE
);

-- Deleting a profile detaches its share first, so its rows emit no tombstones (peers keep their data).
CREATE TRIGGER sync_profile_bd BEFORE DELETE ON Profile
BEGIN
DELETE FROM SyncShare WHERE profileId = old.id;
END;

CREATE TRIGGER sync_deepr_ai AFTER INSERT ON Deepr
WHEN (SELECT applying FROM SyncDevice WHERE id = 1) = 0
BEGIN
UPDATE Deepr SET syncId = lower(hex(randomblob(16))) WHERE id = new.id AND syncId IS NULL;
UPDATE SyncDevice SET hlc = MAX(hlc + 1, CAST((julianday('now') - 2440587.5) * 86400000.0 AS INTEGER) * 65536) WHERE id = 1;
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted)
SELECT s.shareId, x.syncId, '', d.hlc, d.deviceId, 0 FROM SyncShare s, SyncDevice d, Deepr x
WHERE s.profileId = new.profileId AND d.id = 1 AND x.id = new.id;
DELETE FROM SyncMeta WHERE syncId = (SELECT syncId FROM Deepr WHERE id = new.id)
AND EXISTS (SELECT 1 FROM SyncMeta n WHERE n.shareId = SyncMeta.shareId AND n.syncId = SyncMeta.syncId AND n.tagName = SyncMeta.tagName AND n.seq > SyncMeta.seq);
END;

-- Moving a link to another profile = tombstone in the old share + a new identity (syncId) in the new one.
CREATE TRIGGER sync_deepr_au AFTER UPDATE OF link, name, notes, profileId ON Deepr
WHEN (SELECT applying FROM SyncDevice WHERE id = 1) = 0
AND (old.link IS NOT new.link OR old.name IS NOT new.name OR old.notes IS NOT new.notes OR old.profileId IS NOT new.profileId)
BEGIN
UPDATE SyncDevice SET hlc = MAX(hlc + 1, CAST((julianday('now') - 2440587.5) * 86400000.0 AS INTEGER) * 65536) WHERE id = 1;
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted)
SELECT m.shareId, m.syncId, m.tagName, d.hlc, d.deviceId, 1 FROM SyncMeta m, SyncDevice d, SyncShare s
WHERE old.profileId IS NOT new.profileId AND d.id = 1 AND s.profileId = old.profileId
AND m.shareId = s.shareId AND m.syncId = old.syncId AND m.deleted = 0;
UPDATE Deepr SET syncId = lower(hex(randomblob(16))) WHERE id = new.id AND old.profileId IS NOT new.profileId;
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted)
SELECT s.shareId, x.syncId, '', d.hlc, d.deviceId, 0 FROM SyncShare s, SyncDevice d, Deepr x
WHERE s.profileId = new.profileId AND d.id = 1 AND x.id = new.id;
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted)
SELECT s.shareId, x.syncId, t.name, d.hlc, d.deviceId, 0 FROM SyncShare s, SyncDevice d, Deepr x, LinkTags lt, Tags t
WHERE old.profileId IS NOT new.profileId AND s.profileId = new.profileId AND d.id = 1 AND x.id = new.id
AND lt.linkId = new.id AND t.id = lt.tagId;
DELETE FROM SyncMeta WHERE syncId IN (old.syncId, (SELECT syncId FROM Deepr WHERE id = new.id))
AND EXISTS (SELECT 1 FROM SyncMeta n WHERE n.shareId = SyncMeta.shareId AND n.syncId = SyncMeta.syncId AND n.tagName = SyncMeta.tagName AND n.seq > SyncMeta.seq);
END;

CREATE TRIGGER sync_deepr_bd BEFORE DELETE ON Deepr
WHEN (SELECT applying FROM SyncDevice WHERE id = 1) = 0
BEGIN
UPDATE SyncDevice SET hlc = MAX(hlc + 1, CAST((julianday('now') - 2440587.5) * 86400000.0 AS INTEGER) * 65536) WHERE id = 1;
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted)
SELECT m.shareId, m.syncId, m.tagName, d.hlc, d.deviceId, 1 FROM SyncMeta m, SyncDevice d, SyncShare s
WHERE d.id = 1 AND s.profileId = old.profileId AND m.shareId = s.shareId AND m.syncId = old.syncId AND m.deleted = 0;
DELETE FROM SyncMeta WHERE syncId = old.syncId
AND EXISTS (SELECT 1 FROM SyncMeta n WHERE n.shareId = SyncMeta.shareId AND n.syncId = SyncMeta.syncId AND n.tagName = SyncMeta.tagName AND n.seq > SyncMeta.seq);
END;

CREATE TRIGGER sync_linktags_ai AFTER INSERT ON LinkTags
WHEN (SELECT applying FROM SyncDevice WHERE id = 1) = 0
BEGIN
UPDATE SyncDevice SET hlc = MAX(hlc + 1, CAST((julianday('now') - 2440587.5) * 86400000.0 AS INTEGER) * 65536) WHERE id = 1;
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted)
SELECT s.shareId, x.syncId, t.name, d.hlc, d.deviceId, 0 FROM Deepr x, SyncShare s, SyncDevice d, Tags t
WHERE x.id = new.linkId AND s.profileId = x.profileId AND d.id = 1 AND t.id = new.tagId;
DELETE FROM SyncMeta WHERE syncId = (SELECT syncId FROM Deepr WHERE id = new.linkId)
AND EXISTS (SELECT 1 FROM SyncMeta n WHERE n.shareId = SyncMeta.shareId AND n.syncId = SyncMeta.syncId AND n.tagName = SyncMeta.tagName AND n.seq > SyncMeta.seq);
END;

CREATE TRIGGER sync_linktags_ad AFTER DELETE ON LinkTags
WHEN (SELECT applying FROM SyncDevice WHERE id = 1) = 0
BEGIN
UPDATE SyncDevice SET hlc = MAX(hlc + 1, CAST((julianday('now') - 2440587.5) * 86400000.0 AS INTEGER) * 65536) WHERE id = 1;
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted)
SELECT s.shareId, x.syncId, t.name, d.hlc, d.deviceId, 1 FROM Deepr x, SyncShare s, SyncDevice d, Tags t
WHERE x.id = old.linkId AND s.profileId = x.profileId AND d.id = 1 AND t.id = old.tagId;
DELETE FROM SyncMeta WHERE syncId = (SELECT syncId FROM Deepr WHERE id = old.linkId)
AND EXISTS (SELECT 1 FROM SyncMeta n WHERE n.shareId = SyncMeta.shareId AND n.syncId = SyncMeta.syncId AND n.tagName = SyncMeta.tagName AND n.seq > SyncMeta.seq);
END;

CREATE TRIGGER sync_tags_bd BEFORE DELETE ON Tags
WHEN (SELECT applying FROM SyncDevice WHERE id = 1) = 0
BEGIN
UPDATE SyncDevice SET hlc = MAX(hlc + 1, CAST((julianday('now') - 2440587.5) * 86400000.0 AS INTEGER) * 65536) WHERE id = 1;
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted)
SELECT s.shareId, x.syncId, old.name, d.hlc, d.deviceId, 1 FROM LinkTags lt, Deepr x, SyncShare s, SyncDevice d
WHERE lt.tagId = old.id AND x.id = lt.linkId AND s.profileId = x.profileId AND d.id = 1;
DELETE FROM SyncMeta WHERE tagName = old.name
AND EXISTS (SELECT 1 FROM SyncMeta n WHERE n.shareId = SyncMeta.shareId AND n.syncId = SyncMeta.syncId AND n.tagName = SyncMeta.tagName AND n.seq > SyncMeta.seq);
END;

CREATE TRIGGER sync_tags_au AFTER UPDATE OF name ON Tags
WHEN (SELECT applying FROM SyncDevice WHERE id = 1) = 0 AND old.name IS NOT new.name
BEGIN
UPDATE SyncDevice SET hlc = MAX(hlc + 1, CAST((julianday('now') - 2440587.5) * 86400000.0 AS INTEGER) * 65536) WHERE id = 1;
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted)
SELECT s.shareId, x.syncId, old.name, d.hlc, d.deviceId, 1 FROM LinkTags lt, Deepr x, SyncShare s, SyncDevice d
WHERE lt.tagId = new.id AND x.id = lt.linkId AND s.profileId = x.profileId AND d.id = 1;
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted)
SELECT s.shareId, x.syncId, new.name, d.hlc, d.deviceId, 0 FROM LinkTags lt, Deepr x, SyncShare s, SyncDevice d
WHERE lt.tagId = new.id AND x.id = lt.linkId AND s.profileId = x.profileId AND d.id = 1;
DELETE FROM SyncMeta WHERE tagName IN (old.name, new.name)
AND EXISTS (SELECT 1 FROM SyncMeta n WHERE n.shareId = SyncMeta.shareId AND n.syncId = SyncMeta.syncId AND n.tagName = SyncMeta.tagName AND n.seq > SyncMeta.seq);
END;

lastInsertRowId:
SELECT last_insert_rowid();

insertDeepr:
INSERT INTO Deepr (link, name, openedCount, notes, thumbnail, profileId) VALUES (?, ?, ?, ?, ?, ?);

importDeepr:
INSERT INTO Deepr (link, name, openedCount, notes, thumbnail, isFavourite, createdAt, profileId) VALUES (?, ?, ?, ?, ?, ?, ?, ?);

getLinksAndTags:
SELECT
  Deepr.id AS id,
  Deepr.link,
  Deepr.name,
  Deepr.createdAt,
  Deepr.openedCount,
  Deepr.isFavourite,
  Deepr.notes,
  Deepr.thumbnail,
  Deepr.profileId,
  DOL_Max.lastOpenedAt,
  GROUP_CONCAT(Tags.name, ', ') AS tagsNames,
  GROUP_CONCAT(Tags.id, ', ') AS tagsIds
FROM
  Deepr
  LEFT JOIN (
        -- Subquery to find the single latest log entry per deeplink
        SELECT
          deeplinkId,
          MAX(openedAt) AS lastOpenedAt
        FROM
          DeeprOpenLog
        GROUP BY
          deeplinkId
      ) AS DOL_Max ON Deepr.id = DOL_Max.deeplinkId
  LEFT JOIN LinkTags ON Deepr.id = LinkTags.linkId
  LEFT JOIN Tags ON LinkTags.tagId = Tags.id
WHERE
  Deepr.profileId = ?
  AND (Deepr.link LIKE '%' || ? || '%' OR Deepr.name LIKE '%' || ? || '%' OR Deepr.notes LIKE '%' || ? || '%')
  AND (
    ? = -1 OR Deepr.isFavourite = ?
  )
  AND (
    ? = '' OR (
      SELECT COUNT(DISTINCT lt.tagId)
      FROM LinkTags lt
      WHERE lt.linkId = Deepr.id
        AND (',' || ? || ',' LIKE '%,' || CAST(lt.tagId AS TEXT) || ',%')
    ) > 0
  )
GROUP BY
  Deepr.id
ORDER BY
    CASE WHEN ? = 'ASC' THEN
        CASE ?
            WHEN 'createdAt' THEN Deepr.createdAt
            WHEN 'openedCount' THEN Deepr.openedCount
            WHEN 'name' THEN Deepr.name
            WHEN 'link' THEN Deepr.link
            ELSE Deepr.createdAt
        END
    END ASC,
    CASE WHEN ? = 'DESC' THEN
        CASE ?
            WHEN 'createdAt' THEN Deepr.createdAt
            WHEN 'openedCount' THEN Deepr.openedCount
            WHEN 'name' THEN Deepr.name
            WHEN 'link' THEN Deepr.link
            ELSE Deepr.createdAt
        END
    END DESC;

getLinksForBackup:
SELECT
  D.id,
  D.link,
  D.name,
  D.createdAt,
  D.openedCount,
  D.isFavourite,
  D.notes,
  D.thumbnail,
  D.profileId,
  P.name AS profileName,
  DOL_Max.lastOpenedAt,
  GROUP_CONCAT(T.name, ', ') AS tags
FROM Deepr AS D
JOIN Profile AS P ON D.profileId = P.id
LEFT JOIN (
      SELECT
        deeplinkId,
        MAX(openedAt) AS lastOpenedAt
      FROM
        DeeprOpenLog
      GROUP BY
        deeplinkId
    ) AS DOL_Max ON D.id = DOL_Max.deeplinkId
LEFT JOIN LinkTags AS LT ON D.id = LT.linkId
LEFT JOIN Tags AS T ON LT.tagId = T.id
GROUP BY
  D.id;


listDeeprAsc:
SELECT * FROM Deepr ORDER BY createdAt ASC;

listDeeprWithTagsAsc:
SELECT
  Deepr.id AS id,
  Deepr.link,
  Deepr.name,
  Deepr.createdAt,
  Deepr.openedCount,
  Deepr.notes,
  Deepr.thumbnail,
  Deepr.isFavourite,
  DOL_Max.lastOpenedAt,
  GROUP_CONCAT(Tags.name, ', ') AS tagsNames
FROM
  Deepr
  LEFT JOIN (
      -- Subquery to find the single latest log entry per deeplink
      SELECT
        deeplinkId,
        MAX(openedAt) AS lastOpenedAt
      FROM
        DeeprOpenLog
      GROUP BY
        deeplinkId
    ) AS DOL_Max ON Deepr.id = DOL_Max.deeplinkId
  LEFT JOIN LinkTags ON Deepr.id = LinkTags.linkId
  LEFT JOIN Tags ON LinkTags.tagId = Tags.id
GROUP BY
  Deepr.id
ORDER BY
  Deepr.createdAt ASC;

deleteDeeprById:
DELETE FROM Deepr WHERE id = ?;

incrementOpenedCount:
UPDATE Deepr SET openedCount = openedCount + 1 WHERE id = ?;

resetOpenedCount:
UPDATE Deepr SET openedCount = 0 WHERE id = ?;

updateDeeplink:
UPDATE Deepr SET link = ? , name = ?, notes = ?, thumbnail = ?, profileId = ? WHERE id = ?;

countDeepr:
SELECT COUNT(*) FROM Deepr;

getDeeprByLink:
SELECT * FROM Deepr WHERE link = ?;

getDeeprById:
SELECT * FROM Deepr WHERE id = ?;


-- Tag operations
insertTag:
INSERT OR IGNORE INTO Tags (name) VALUES (?);

getTagByName:
SELECT * FROM Tags WHERE name = ?;

getAllTags:
SELECT * FROM Tags ORDER BY name;

getAllTagsWithCount:
SELECT 
  Tags.id,
  Tags.name,
  COUNT(DISTINCT CASE WHEN Deepr.profileId = ? THEN LinkTags.linkId END) AS linkCount
FROM Tags
LEFT JOIN LinkTags ON Tags.id = LinkTags.tagId
LEFT JOIN Deepr ON LinkTags.linkId = Deepr.id
GROUP BY Tags.id, Tags.name

ORDER BY linkCount DESC, Tags.name;

countOfLinks:
SELECT count(*) FROM Deepr WHERE profileId = ?;

countOfFavouriteLinks:
SELECT count(*) FROM Deepr WHERE isFavourite = 1 AND profileId = ?;


-- Link-Tag relations
addTagToLink:
INSERT OR IGNORE INTO LinkTags (linkId, tagId) VALUES (?, ?);

removeTagFromLink:
DELETE FROM LinkTags WHERE linkId = ? AND tagId = ?;

deleteLinkRelations:
DELETE FROM LinkTags WHERE linkId = ?;


deleteTag:
DELETE FROM Tags WHERE id = ?;

deleteTagRelations:
DELETE FROM LinkTags WHERE tagId = ?;

updateTag:
UPDATE Tags SET name = ? WHERE id = ?;

getTagsForLink:
SELECT Tags.id,Tags.name FROM Tags INNER JOIN LinkTags ON Tags.id = LinkTags.tagId WHERE LinkTags.linkId = ? ORDER BY Tags.name;

hasTagLinks:
SELECT COUNT(*) FROM LinkTags WHERE tagId = ?;

-- Deeplink Open Log operations
insertDeeprOpenLog:
INSERT INTO DeeprOpenLog (deeplinkId) VALUES (?);

getLastOpenedTime:
SELECT openedAt FROM DeeprOpenLog WHERE deeplinkId = ? ORDER BY openedAt DESC LIMIT 1;

toggleFavourite:
UPDATE Deepr SET isFavourite = CASE WHEN isFavourite = 0 THEN 1 ELSE 0 END WHERE id = ?;

setFavourite:
UPDATE Deepr SET isFavourite = ? WHERE id = ?;

-- Profile operations
insertProfile:
INSERT OR IGNORE INTO Profile (name) VALUES (?);

insertProfileWithPriority:
INSERT OR IGNORE INTO Profile (name, priority) VALUES (?, ?);

insertProfileAutoPriority:
INSERT OR IGNORE INTO Profile (name, priority)
VALUES (?, (SELECT COALESCE(MAX(priority), 0) + 1 FROM Profile));

getAllProfiles:
SELECT * FROM Profile ORDER BY priority ASC, createdAt ASC;

getProfileById:
SELECT * FROM Profile WHERE id = ?;

getProfileByName:
SELECT * FROM Profile WHERE name = ?;

updateProfile:
UPDATE Profile SET name = ?, themeMode = ?, colorTheme = ? WHERE id = ?;

updateProfilePriority:
UPDATE Profile SET priority = ? WHERE id = ?;

maxPriority:
SELECT MAX(priority) FROM Profile;

deleteProfile:
DELETE FROM Profile WHERE id = ?;

deleteAllProfiles:
DELETE FROM Profile;

deleteAllTags:
DELETE FROM Tags;

countProfiles:
SELECT COUNT(*) FROM Profile;


-- P2P sync (docs/p2p-sync/PLAN.md)
getSyncDevice:
SELECT * FROM SyncDevice WHERE id = 1;

setSyncApplying:
UPDATE SyncDevice SET applying = ? WHERE id = 1;

observeHlc:
UPDATE SyncDevice SET hlc = MAX(hlc, ?) WHERE id = 1;

tickHlc:
UPDATE SyncDevice SET hlc = MAX(hlc + 1, CAST((julianday('now') - 2440587.5) * 86400000.0 AS INTEGER) * 65536) WHERE id = 1;

setDeviceId:
UPDATE SyncDevice SET deviceId = ? WHERE id = 1;

setDeviceName:
UPDATE SyncDevice SET deviceName = ? WHERE id = 1;

setMaxPeers:
UPDATE SyncDevice SET maxPeers = ? WHERE id = 1;

insertShare:
INSERT INTO SyncShare (shareId, profileId, createdAt) VALUES (?, ?, ?);

deleteShare:
DELETE FROM SyncShare WHERE shareId = ?;

getShareById:
SELECT * FROM SyncShare WHERE shareId = ?;

getShareByProfile:
SELECT * FROM SyncShare WHERE profileId = ?;

getAllShares:
SELECT * FROM SyncShare;

-- Call tickHlc first, in the same transaction.
seedShareLinks:
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted)
SELECT s.shareId, x.syncId, '', d.hlc, d.deviceId, 0 FROM SyncShare s, Deepr x, SyncDevice d
WHERE s.shareId = ? AND x.profileId = s.profileId AND d.id = 1;

seedShareTags:
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted)
SELECT s.shareId, x.syncId, t.name, d.hlc, d.deviceId, 0 FROM SyncShare s, Deepr x, SyncDevice d, LinkTags lt, Tags t
WHERE s.shareId = ? AND x.profileId = s.profileId AND d.id = 1 AND lt.linkId = x.id AND t.id = lt.tagId;

getMeta:
SELECT * FROM SyncMeta WHERE shareId = ? AND syncId = ? AND tagName = ?;

deleteMeta:
DELETE FROM SyncMeta WHERE shareId = ? AND syncId = ? AND tagName = ?;

insertMeta:
INSERT INTO SyncMeta (shareId, syncId, tagName, hlc, origin, deleted) VALUES (?, ?, ?, ?, ?, ?);

deltaPage:
SELECT m.seq, m.syncId, m.tagName, m.hlc, m.origin, m.deleted, x.link, x.name, x.notes, x.createdAt
FROM SyncMeta m LEFT JOIN Deepr x ON m.tagName = '' AND m.deleted = 0 AND x.syncId = m.syncId
WHERE m.shareId = ? AND m.seq > ?
ORDER BY m.seq
LIMIT ?;

liveSyncedTags:
SELECT tagName FROM SyncMeta WHERE shareId = ? AND syncId = ? AND tagName != '' AND deleted = 0;

getDeeprBySyncId:
SELECT * FROM Deepr WHERE syncId = ?;

insertDeeprSynced:
INSERT INTO Deepr (link, name, notes, createdAt, profileId, syncId) VALUES (?, ?, ?, ?, ?, ?);

updateDeeprSynced:
UPDATE Deepr SET link = ?, name = ?, notes = ? WHERE syncId = ?;

deleteDeeprBySyncId:
DELETE FROM Deepr WHERE syncId = ?;

liveLinksWithUrl:
SELECT id, syncId FROM Deepr WHERE profileId = ? AND link = ? ORDER BY syncId;

insertPeer:
INSERT INTO SyncPeer (peerId, name, keyEnc, lastHost, lastPort, addedAt) VALUES (?, ?, ?, ?, ?, ?);

getAllPeers:
SELECT * FROM SyncPeer ORDER BY addedAt;

getPeer:
SELECT * FROM SyncPeer WHERE peerId = ?;

countPeers:
SELECT COUNT(*) FROM SyncPeer;

deletePeer:
DELETE FROM SyncPeer WHERE peerId = ?;

deleteAllPeers:
DELETE FROM SyncPeer;

updatePeerAddress:
UPDATE SyncPeer SET lastHost = ?, lastPort = ? WHERE peerId = ?;

updatePeerSyncStatus:
UPDATE SyncPeer SET lastSyncAt = ?, lastError = ? WHERE peerId = ?;

markAllPeersNeedRepair:
UPDATE SyncPeer SET needsRepair = 1;

linkPeerShare:
INSERT OR IGNORE INTO SyncPeerShare (peerId, shareId) VALUES (?, ?);

unlinkPeerShare:
DELETE FROM SyncPeerShare WHERE peerId = ? AND shareId = ?;

getPeerShare:
SELECT * FROM SyncPeerShare WHERE peerId = ? AND shareId = ?;

getPeerShares:
SELECT ps.peerId, ps.shareId, ps.pushedUpTo, ps.pulledUpTo, s.profileId
FROM SyncPeerShare ps JOIN SyncShare s ON s.shareId = ps.shareId
WHERE ps.peerId = ?;

getSharePeers:
SELECT * FROM SyncPeerShare WHERE shareId = ?;

setCursors:
UPDATE SyncPeerShare SET pushedUpTo = ?, pulledUpTo = ? WHERE peerId = ? AND shareId = ?;
